---
import { about } from "../data/about";
import { projects } from "../data/projects";
import { cvMarkdown } from "../data/markdown";
import "../styles/global.css";

const markdown = cvMarkdown(Astro.site?.origin ?? "");
const headlineBase = about.headline.replace(/\.$/, "");

/** Phrase to bold wherever it appears in the bio. */
const highlight = "AI-native product engineer";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Raja Sekar — Staff Engineer building AI-native product experiences end-to-end."
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Raja Sekar M" />
    <meta
      property="og:description"
      content="Raja Sekar — Staff Engineer building AI-native product experiences end-to-end."
    />
    <title>Raja Sekar M</title>
  </head>
  <body>
    <div class="container">
      <main class="page">

        <!-- Human / AI version toggle -->
        <div class="version-toggle" role="group" aria-label="Page version">
          <button type="button" id="human-toggle" class="version-button is-active" aria-pressed="true">Human</button>
          <button type="button" id="ai-toggle" class="version-button" aria-pressed="false">AI</button>
        </div>

        <!-- AI version: plain markdown for language models -->
        <section id="ai-view" aria-label="AI-readable version" hidden>
          <p class="ai-view-note">
            Markdown for language models — also at <a href="/llms.txt">/llms.txt</a>.
          </p>
          <pre class="ai-view-markdown"><code>{markdown}</code></pre>
        </section>

        <div id="human-view">
        <!-- About section -->
        <section aria-labelledby="about-heading">
          <h1 id="about-heading" class="about-greeting">{about.greeting}</h1>
          <h2 class="about-headline">
            {headlineBase} <span class="thinking-dots" aria-hidden="true"><span>.</span><span>.</span><span>.</span></span>
          </h2>
          <div class="about-bio">
            {
              about.bio.map((paragraph) => (
                <p>
                  {paragraph.split(highlight).map((part, i, parts) => (
                    <>
                      {part}
                      {i < parts.length - 1 && <strong>{highlight}</strong>}
                    </>
                  ))}
                </p>
              ))
            }
          </div>
          <nav class="about-links" aria-label="Social links">
            <a href={about.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a href={about.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          </nav>
        </section>


        <!-- Work section -->
        <section aria-labelledby="work-heading">
          <h2 class="section-label" id="work-heading">Projects</h2>
          <ul class="work-list" role="list">
            {
              projects.map((project) => (
                <li class="work-item">
                  <div class="work-item-header">
                    {project.href ? (
                      <a class="work-item-name work-item-name-link" href={project.href}>
                        {project.name}
                      </a>
                    ) : (
                      <span class="work-item-name">{project.name}</span>
                    )}
                    <span class="work-item-year">{project.year}</span>
                  </div>
                  <p class="work-item-description">{project.description}</p>
                  {project.repoUrl && (
                    <a
                      class="work-item-link"
                      href={project.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {project.repoUrl.replace("https://", "")}
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
        </section>
        </div>
      </main>
    </div>

    <script>
      const humanToggle = document.getElementById("human-toggle")!;
      const aiToggle = document.getElementById("ai-toggle")!;
      const humanView = document.getElementById("human-view")!;
      const aiView = document.getElementById("ai-view")!;

      function setVersion(version: "human" | "ai") {
        const isAi = version === "ai";
        humanView.hidden = isAi;
        aiView.hidden = !isAi;
        humanToggle.classList.toggle("is-active", !isAi);
        aiToggle.classList.toggle("is-active", isAi);
        humanToggle.setAttribute("aria-pressed", String(!isAi));
        aiToggle.setAttribute("aria-pressed", String(isAi));
      }

      humanToggle.addEventListener("click", () => setVersion("human"));
      aiToggle.addEventListener("click", () => setVersion("ai"));
    </script>
  </body>
</html>
